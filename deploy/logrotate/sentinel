# Sentinel writes structured logs to journald, not to files, so there is little
# here. What does need rotating is nginx's Sentinel vhost logs and Suricata's
# eve.json.
#
# The critical part is `copytruncate` being ABSENT for eve.json and the
# postrotate signal being present instead. Sentinel's collectors track files by
# (device, inode, offset). copytruncate keeps the inode and resets the size,
# which the tailer reads as "the file shrank" — it recovers, but it loses
# whatever was written between the copy and the truncate. A real rotation plus
# a signal is lossless.

/var/log/nginx/sentinel-*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    create 0640 nginx adm
    postrotate
        [ -f /var/run/nginx.pid ] && kill -USR1 "$(cat /var/run/nginx.pid)" 2>/dev/null || true
    endscript
}

/var/log/suricata/eve.json {
    daily
    rotate 3
    missingok
    notifempty
    compress
    delaycompress
    create 0640 suricata suricata
    # Only three days, and rotation is aggressive: even with a BPF filter
    # excluding bulk flows, eve.json is the largest thing Sentinel
    # produces, and this host does not have disk to spare.
    maxsize 500M
    postrotate
        # Suricata reopens its log files on SIGHUP. Without this it keeps
        # writing to the rotated inode and the new file stays empty.
        systemctl kill -s HUP suricata 2>/dev/null || true
    endscript
}

/var/log/suricata/*.log {
    weekly
    rotate 4
    missingok
    notifempty
    compress
    create 0640 suricata suricata
}
