# Imaginea probei de capăt-la-capăt pentru familia `debian`: Ubuntu cu systemd ca PID 1.
# `needrestart` e instalat ca pe gazda n8n (Ubuntu îl pune implicit): fără el, proba
# `NEEDRESTART_MODE=l` ar demonstra o protecție împotriva unui lucru care nu există aici.
# Folosită de run.sh cu E2E_DISTRO=debian; nu se rulează altfel.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends systemd systemd-sysv dbus python3 python3-venv python3-pip \
        sudo util-linux procps tar zstd ca-certificates needrestart \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
