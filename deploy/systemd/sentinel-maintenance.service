[Unit]
# Hourly housekeeping: create tomorrow's partitions, drop expired ones, compute
# rollups, refresh threat intel and EPSS/KEV, score due predictions, check
# certificate expiry, and run the disk guard.
#
# The partition work is why this must not be skipped: without it, inserts start
# landing in the DEFAULT partition and retention stops reclaiming space.
Description=Sentinel maintenance (retention, rollups, intel refresh)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentinel
ExecStart=/opt/sentinel/bin/sentinel maintenance
TimeoutStartSec=900

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/sentinel/lib

# Housekeeping must never compete with detection for CPU or disk.
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

# Namespaces, realtime scheduling and a restrictive umask. Neither unit has any
# use for a namespace or for realtime priority.
RestrictNamespaces=yes
RestrictRealtime=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
MemoryDenyWriteExecute=true
UMask=0077
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @swap @reboot @raw-io @obsolete
CapabilityBoundingSet=

ReadWritePaths=/var/lib/sentinel /var/backups/sentinel
ReadOnlyPaths=/etc/sentinel

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

MemoryMax=384M
TasksMax=64

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-maintenance
