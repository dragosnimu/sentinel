[Unit]
# Vulnerability scanning: dnf updateinfo, Trivy, SCA, nuclei, semgrep, Lynis.
#
# Isolated in its own oneshot unit because these tools spike hard — Trivy
# loading its database, semgrep parsing a large repo — and a memory spike here
# must never be able to stop detection or, worse, pressure the application this
# host exists to run into an OOM kill. Hence the low priority, idle I/O class,
# and a hard MemoryMax.
Description=Sentinel vulnerability scan
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentinel
ExecStart=/opt/sentinel/bin/sentinel scan
# A full scan of every asset with every scanner is slow by nature. Four hours
# is generous; the scheduler runs it inside the 03:00-05:00 window and the
# orchestrator enforces per-scanner timeouts of its own.
TimeoutStartSec=14400

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/sentinel/lib

Nice=19
IOSchedulingClass=idle
CPUWeight=20

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @debug

# Namespaces, realtime scheduling and a restrictive umask. None of these units
# has any use for a namespace or for realtime priority, and each one denied is
# a step removed from turning a bug here into something worse.
RestrictNamespaces=yes
RestrictRealtime=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
MemoryDenyWriteExecute=true
UMask=0077
SystemCallFilter=~@resources

# Scanners read application source and webroots; that is the job.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH

# Cache-ul propriu de metadate dnf.
#
# Masurat pe 21 august 2026, pe gazda reala: `dnf updateinfo list cves` ruleaza
# in 7 secunde ca root, care foloseste cache-ul sistemului din /var/cache/dnf, si
# in 82 ca utilizatorul `sentinel`, care NU-l poate citi si reparseaza de fiecare
# data toate metadatele. Plafonul scanerului era 120 de secunde, deci in fiecare
# noapte era o moneda aruncata: patru rulari din ultimele opt au durat intre 108
# si 120 de secunde, iar doua au fost omorate la fix 120.
#
# Cu un cache al lui, scris o data si refolosit: 2,4 secunde. Masurat, de trei
# ori la rand.
#
# `CacheDirectory=` il creeaza systemd, cu proprietarul serviciului, si il
# pastreaza intre rulari — spre deosebire de `RuntimeDirectory=`, care l-ar
# sterge la oprire si ar readuce exact problema. Ocupa in jur de 205 MB.
CacheDirectory=sentinel-dnf
CacheDirectoryMode=0750

ReadWritePaths=/var/lib/sentinel
ReadOnlyPaths=/etc/sentinel /var/www /opt /srv

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

MemoryMax=1G
TasksMax=256
OOMPolicy=stop

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-scan
