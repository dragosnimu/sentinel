# Sentinel main configuration.
#
# Rendered by install.sh. An existing file is NEVER overwritten — the installer
# writes sentinel.yaml.new alongside it and prints a diff.
#
# Secrets do not belong here. They live in secrets.env (0640 root:sentinel).
# Safety boundaries — the never-block networks, the patch binary allowlist, the
# protected paths — are in code (sentinel/constants.py, executor/policy.py) and
# are deliberately not configurable.

timezone: Europe/Bucharest
hostname: "@@HOSTNAME@@"

# Numele sub care vrei să vezi instalarea asta într-un panou care adună mai
# multe servere. Ex.: "prod-web-1". Gol e în regulă — atunci se arată
# identificatorul.
#
# Doar cosmetic. NU e cheie și nu e identificator: identitatea instalării e
# valoarea aleatoare din /etc/sentinel/instance_id, generată o dată la instalare
# și niciodată regenerată. Schimbarea etichetei de aici redenumește o linie
# într-un panou și nu mută nimic dintr-o istorie în alta.
instance_label: ""

log_level: INFO

database:
  host: 127.0.0.1
  port: 5432
  name: sentinel
  user: sentinel
  pool_min: 2
  pool_max: 10
  statement_timeout_ms: 30000

retention:
  # 30 days of raw events at this volume is roughly 1-8 GB. The rollups keep
  # the useful aggregate far longer at a fraction of the size.
  raw_events_days: 30
  rollup_1m_days: 90
  rollup_1h_days: 400
  health_samples_days: 30
  # Below this, the maintenance job drops the oldest partitions early and
  # alerts, rather than letting the filesystem fill and take PostgreSQL — and
  # everything else on the host — down with it.
  disk_guard_free_pct: 15

  # După câte zile fără activitate nouă se închide singur un incident.
  #
  # Nu e o politică de retenție, e una de citire. Nimic nu se șterge: rândul
  # rămâne cu toate probele, cronologia câștigă o intrare cu cine și de ce, iar
  # activitate nouă deschide un incident NOU, nu îl învie pe cel vechi.
  #
  # Motivul pentru care există: fundalul internetului produce ~120 de incidente
  # pe zi pe un server expus. După o săptămână ai 850 deschise, nimeni nu le mai
  # citește, iar cel care conta se ascunde printre cele 849 care nu contau.
  #
  # `critical` lipsește dinadins și nu se închide niciodată singur. Un critic la
  # care nu s-a uitat nimeni de două săptămâni e o constatare despre operator,
  # nu despre incident. Adăugarea lui aici nu are efect — codul refuză.
  incident_stale_days:
    info: 1
    low: 2
    medium: 7
    high: 21

ingest:
  # journald: sshd/sshd-session (autentificare) + sudo/su (escaladare privilegii).
  journald: true
  nginx: true
  apache: false
  # auditd: doar tipurile de înregistrări relevante pentru securitate
  # (autentificări, USER_CMD, modificări de conturi, AVC, crash-uri). Restul e
  # filtrat în colector — auditd poate produce zeci de mii de linii pe zi.
  auditd: true
  suricata: @@SURICATA_ENABLED@@
  # NEIMPLEMENTATE încă: nu există colector pentru ele. Lăsate false ca să nu
  # pretindă o acoperire pe care Sentinel nu o are.
  docker: false
  fim: false

  nginx_log_paths:
    - /var/log/nginx/*access*.log

  auditd_log_path: /var/log/audit/audit.log

  # Sources that produce high volume with no security value on this host.
  # Dropped before they reach the database. Add one here if you find a chatty
  # source filling partitions without ever producing a detection.
  exclude_sources: []

  batch_size: 500
  flush_interval_ms: 1000

history:
  # Conturile de automatizare ale căror comenzi FĂRĂ TERMINAL nu se scriu în
  # `session_commands`. `sentinel-deploy` e contul creat de pasul 36 al
  # instalării; dacă ai pornit instalatorul cu alt `DEPLOY_ACCOUNT`, pune aici
  # numele ăla — numele se compară exact.
  #
  # Motivul e o măsurătoare: un singur deploy a produs 405 777 de comenzi în 140
  # de secunde — `systemctl` de 320 591 de ori și `sleep` de 173 376, adică
  # buclele de așteptare ale instalatorului —, iar replica externă a crescut de
  # la 83 MB la 909 MB în câteva ore.
  #
  # Ce NU face lista asta, ca să nu fie citită drept mai mult decât e:
  #
  #   * regulile auditd rămân neatinse, deci `/var/log/audit/audit.log` are în
  #     continuare tot ce a rulat contul. Se taie doar proiecția în bază;
  #   * rândul de sesiune rămâne: „s-a deschis o sesiune de deploy" e faptul cu
  #     valoare de securitate;
  #   * o logare INTERACTIVĂ pe contul ăsta (`ssh sentinel-deploy@gazdă` cu
  #     shell adevărat) capătă `pts0`, deci comenzile ei se păstrează, sesiunea
  #     se promovează și alerta de logare pleacă. Filtrul e pe terminalul
  #     comenzii, nu pe cont — altfel contul de automatizare ar fi chiar o cale
  #     de intrare pe care nu s-ar anunța nimic.
  #
  # Lista goală înseamnă „nu se aruncă nimic".
  skip_command_accounts:
    - sentinel-deploy

detection:
  enabled: true
  rules_dir: /etc/sentinel/rules.d
  # Anomaly rules record but do not alert until a baseline has this much
  # history. Shortening it is how you get several hundred false positives in
  # week one.
  baseline_warmup_days: 14
  suppress_sources: []

response:
  auto_block:
    # ── SHIPS DISABLED. READ BEFORE CHANGING. ───────────────────────────────
    # The first 72 hours are observe-only: you get a Telegram message saying
    # what WOULD have been blocked, with a button to do it. Use that time to
    # find the false positives — uptime monitors, Let's Encrypt validation,
    # search crawlers, CDN edges, your own mobile address, NAT'd office ranges.
    #
    # Turn it on only after a quiet 72 hours:
    #   sed -i 's/enabled: false/enabled: true/' /etc/sentinel/sentinel.yaml
    #   systemctl restart sentinel-detect
    enabled: false

    observe_mode_notify: true

    # Deterministic severity at or above which an armed auto-block may fire.
    # Below it you still get the alert (with a manual block button), but nothing
    # is placed automatically. High keeps enumeration noise from arming.
    min_severity: high

    # Hard caps. A runaway detector must not be able to black-hole the internet
    # one /32 at a time. Exceeding either alerts and refuses further blocks.
    max_per_minute: 60
    max_elements: 20000

    # One bad actor behind a NAT would otherwise take out a whole building.
    allow_cidr_blocks: false

    default_ttl_s: 86400

    # Internet-background-noise research scanners (Shodan, Censys, Rapid7) are
    # not attacking you specifically and blocking them achieves nothing.
    skip_known_scanners: true

  executor_socket: /run/sentinel/executor.sock
  executor_timeout_s: 30

  # Operator additions to the hard-coded never-block list.
  #
  # This is where deployment-specific addresses go: your uptime monitor, your
  # CI runner, your office range, and any high-volume source you must not cut
  # off. The hard-coded list in executor/policy.py covers only the universal
  # cases (loopback, RFC1918, your SSH peer) — everything site-specific belongs
  # here, where you can see it and change it.
  #
  # Entries are loaded into the nftables allowlist at install and refreshed
  # hourly, AND they are what the root executor refuses to block. Your admin
  # address is seeded here at install so the executor will never firewall you off
  # — the nftables allowlist alone is not enough, because that only wins the
  # accept/drop race; the executor still needs to know not to add the rule.
  # Format: CIDR strings, e.g. "203.0.113.0/24".
  extra_allowlist: [@@EXTRA_ALLOWLIST@@]

telegram:
  enabled: true
  # An empty allowlist would accept commands from anyone who finds the bot.
  # Sentinel refuses to start with telegram.enabled and no chat ids.
  allowed_chat_ids:
    - @@TELEGRAM_CHAT_ID@@
  owner_chat_id: @@TELEGRAM_CHAT_ID@@
  operator_chat_ids: []
  viewer_chat_ids: []

  # Deployment-wide quiet window, in local time, e.g. "22:00-06:00". Each chat
  # can set its own from the phone with /mute, which overrides this.
  #
  # Left null on purpose. Muting is a real reduction in coverage, so it is a
  # decision the operator makes knowingly rather than one an installer makes for
  # them. Critical alerts, PANIC, the watchdog and patch failures ignore any
  # window; everything else is held and delivered when the window ends.
  quiet_hours: null
  # IANA zone the window is read in. null = the host's own zone, which is what
  # someone typing "22:00" means.
  timezone: null
  min_severity: medium
  digest_threshold: 10
  rate_limit_per_minute: 30
  callback_ttl_s: 600

  # Defence in depth if a phone is lost or stolen: a static PIN, set in
  # secrets.env as TELEGRAM_APPLY_PIN, required for patch apply and for
  # allowlist changes.
  require_pin_for_apply: false

web:
  # The app itself: loopback only. nginx terminates TLS and applies the rate
  # limits and security headers; binding publicly would bypass all three.
  bind: 127.0.0.1
  port: 8787

  # How the dashboard is exposed. Set by --nginx-mode at install time.
  #
  #   dedicated  Sentinel's own nginx listener on public_port (8443). Touches
  #              nothing that already exists. The URL carries the port, there is
  #              no HTTP->HTTPS redirect, and certbot's HTTP-01 challenge is
  #              unavailable because Sentinel does not own :80.
  #
  #   shared     Sentinel is one vhost among several on the nginx already serving
  #              80 and 443, selected by server_name. Clean URL, working
  #              redirect, and certificates work normally because Sentinel serves
  #              its own ACME challenge. Requires nginx to be what owns those
  #              ports, and writes into a config directory shared with your sites.
  #
  # Changing this is not a config-file edit: re-run the installer with the other
  # --nginx-mode, so the vhost files are replaced and nginx -t is re-validated.
  nginx_mode: @@NGINX_MODE@@

  # The port that appears in the dashboard URL.
  #
  # In dedicated mode nginx binds this, and it must be open in the provider's
  # firewall too — nftables on this host is a deny-lister and does not block it,
  # but a cloud security group will.
  #
  # In shared mode nothing new is bound (the existing nginx already listens on
  # 443) and this is only used to build links.
  public_port: @@PUBLIC_PORT@@

  domain: "@@DOMAIN@@"
  session_ttl_s: 43200
  require_totp: true
  max_failed_logins: 5
  lockout_minutes: 15

  # Empty means any source reaching nginx may attempt a login. Filling this in
  # with your own ranges is the cheapest hardening available for a public
  # security dashboard, and costs nothing — Telegram stays the "from anywhere"
  # channel and does not depend on the dashboard at all.
  ip_allowlist: []

ai:
  enabled: true
  model_fast: claude-haiku-4-5-20251001
  model_main: claude-sonnet-5
  # Patch plans get the strongest model. It is the highest-consequence output
  # in the system and the least frequent, so the cost is irrelevant.
  model_patch: claude-opus-5
  max_tokens: 4096
  timeout_s: 120

  # Hard stop, not a warning. Start conservative and raise it once you have
  # seen a week of real spend. An event storm without a cap is expensive.
  daily_budget_usd: 5.0
  monthly_budget_usd: 100.0

  # Below this severity the deterministic verdict stands and no model is called.
  triage_min_severity: high
  correlate_interval_minutes: 15
  daily_report_at: "08:00"
  ask_rate_limit_per_hour: 10

  cli_binary: claude
  cli_workspace: /opt/sentinel/claude-workspace
  cli_max_turns: 25

scan:
  enabled: true
  window: "03:00-05:00"

  # Telegram alert for NEW vulnerabilities, right after the scan.
  # Only findings this run inserted for the first time — a scan that
  # re-finds the same two hundred sends nothing. A channel that repeats
  # the same list every run is one the operator mutes, and then the
  # alert that mattered is lost with it.
  announce_new: true
  os_packages: true
  containers: true
  filesystem: true
  source_sca: true
  secrets: true

  # semgrep is slow and noisy. Enabling it across every repository buries the
  # findings that matter. Opt in per repository, by path.
  sast_repos: []

  # Active scanning of your own live application. Requires the asset to have
  # confirmed_by_operator: true in inventory.yaml — discovery alone does not
  # authorise attacking something.
  web_dast: false
  nuclei_rate_limit: 20
  nuclei_severities: [medium, high, critical]

  lynis_weekly: true
  discovery_paths: [/var/www, /opt, /srv, /home]
  # One at a time. Two concurrent scanners is how a memory spike becomes an
  # OOM kill of whatever else is running on the host.
  max_concurrent: 1

patch:
  # Generation is automatic. Application never is: it needs two explicit
  # Telegram confirmations, and the approval token is bound to the plan hash.
  auto_generate_for_kev: true

  # Paths no automated patch may touch, on top of the hard-coded floor
  # (/opt/sentinel, /etc/sentinel, /root/.ssh, /etc/ssh, /etc/shadow, /boot...).
  #
  # Put anything here you would rather patch by hand: another product's install
  # directory, a database you cannot afford to have restarted, a mount managed
  # by someone else. The validator rejects any plan that references them.
  extra_protected_paths: []

  backup_dir: /var/backups/sentinel
  retention_count: 10
  retention_days: 30
  require_free_space_multiplier: 3
  dry_run_default: true
  health_check_grace_s: 30
  # An untested backup is not a backup. This schedules the reminder.
  restore_drill_days: 90

health:
  interval_s: 30
  http_timeout_s: 10
  down_after_failures: 3
  degraded_latency_multiplier: 3.0
  disk_warn_pct: 85
  # On a small VPS, memory pressure is the most likely cause of an unexplained
  # outage: the OOM killer picks the largest process, which is usually the
  # application you were trying to protect rather than Sentinel.
  mem_warn_mb: 1024
  mem_critical_mb: 500

intel:
  enabled: true
  refresh_hours: 6
  feeds_dir: /etc/sentinel/feeds.d
  geoip_db: /var/lib/sentinel/geoip/dbip-asn-lite.mmdb
  epss: true
  kev: true

suricata:
  enabled: @@SURICATA_ENABLED@@
  eve_path: /var/log/suricata/eve.json
  interface: @@IFACE@@

  # Traffic Suricata should not inspect at all, in BPF syntax.
  #
  # Empty is a valid and common answer. It matters when this host carries a
  # high-volume flow with no security value — bulk telemetry, a syslog feed,
  # backup replication. Inspecting one of those can fill the disk within hours
  # and produces nothing worth reading.
  #
  # Preflight samples the interface and tells you whether you need this. If it
  # reported a dominant flow, exclude it here, e.g.:
  #   bpf_filter: "not (host 203.0.113.10 and udp port 514)"
  bpf_filter: "@@BPF_FILTER@@"

  # Suricata's own memory ceiling. On a small VPS this is the difference
  # between a NIDS and an OOM kill.
  memcap_mb: 128

# ---------------------------------------------------------------------------
# Beacon — semnalul periodic către un martor din afara acestei gazde.
#
# De ce există: un agent găzduit nu poate raporta credibil propria dispariție.
# Cine oprește serviciile controlează și canalul prin care ar fi anunțat. Așa
# că Sentinel trimite periodic câteva contoare care TREBUIE să crească, iar
# absența semnalului devine alarma — pe o mașină pe care atacatorul nu o are.
#
# Oprirea beaconului nu e o slăbiciune a lui; e exact semnalul.
#
# `url` e ruta /api/sentinel/beat a martorului. Cheia HMAC NU stă aici — stă în
# SENTINEL_BEACON_SECRET din secrets.env, aceeași valoare la ambele capete.
# Fără ea, serviciul spune o dată în jurnal și iese curat; nu pretinde că
# raportează.
beacon:
  enabled: false
  url: ""
  interval_s: 60
  timeout_s: 10
  # Cât de vechi poate fi un semnal când ajunge la martor. Protejează împotriva
  # reluării unui pachet capturat: semnătura e validă la nesfârșit, prospețimea
  # nu.
  max_age_s: 120

# ---------------------------------------------------------------------------
# Ship — expedierea rândurilor către un agregator extern.
#
# Alt lucru decât beaconul, deși seamănă. Beaconul trimite câteva CONTOARE și
# absența lui e alarma; expeditorul trimite CONȚINUT, ca să existe o copie a
# jurnalului de audit pe o mașină pe care cine intră aici nu o controlează.
# Servicii separate, chei separate: purtarea beaconului (nu reîncearcă, nu
# blochează) e o proprietate de securitate, iar un bug în expeditor nu are voie
# să fie o pană de heartbeat.
#
# Cheia HMAC NU stă aici — stă în SENTINEL_SHIP_SECRET din secrets.env, și e
# DISTINCTĂ de cea a beaconului: o cheie comună înseamnă că root pe o gazdă
# poate fabrica date în numele alteia.
#
# Regula pe care stă totul: cursorul avansează doar când răspunsul ecouă exact
# filigranul trimis, pe flux. Nu pe HTTP 200 — un 200 de la un CDN, de la un
# vhost greșit rutat sau de la un agregator care nu cunoaște fluxul arată la fel.
ship:
  enabled: false
  url: ""
  interval_s: 60
  # Mai lung decât la beacon: un lot de mii de rânduri nu e un heartbeat.
  timeout_s: 30
  max_age_s: 300
  # Cea mai mare cerere pe care o poate produce o rundă. O pană lungă a
  # agregatorului se recuperează în multe cereri mici, nu într-una uriașă care
  # expiră și se reia la nesfârșit fără să progreseze.
  max_rows_per_batch: 2000
  # De unde începe un flux la PRIMA rundă, când încă nu există cursor. Rândurile
  # mai vechi de atât nu vor pleca niciodată — scris în jurnal atunci și
  # raportat permanent de verificarea `ship:lag`, ca să nu fie o omisiune
  # tăcută. După ce cursorul există, limita asta nu mai sare peste nimic: o
  # restanță de o lună se recuperează întreagă.
  max_backfill_days: 7
  # Backoff exponențial cu jitter, plafonat.
  backoff_base_s: 30
  backoff_max_s: 3600
