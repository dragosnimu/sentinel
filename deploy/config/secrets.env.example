# Sentinel secrets — TEMPLATE. Keys only, never values.
#
# The real file lives at /etc/sentinel/secrets.env, mode 0640 root:sentinel.
# It is written by install.sh from values transferred over the SSH channel via
# stdin. It is never committed, never packaged into a deploy tarball, never
# passed as a command-line argument (where `ps` would show it), and never
# logged — sentinel/util/shellsafe.py redacts anything key-shaped from captured
# output before it reaches the journal, the database or a Telegram message.
#
# To create your local copy:  ./scripts/secrets-init.sh
# That writes secrets/.env.local, which is gitignored and rejected by the
# pre-commit hook.

# --- Database ---------------------------------------------------------------
# Generated by secrets-init.sh. Also set as the PostgreSQL role password by the
# installer, so changing it here alone is not enough — rerun step 22.
SENTINEL_DB_PASSWORD=

# --- Anthropic --------------------------------------------------------------
# sk-ant-...  Used for triage, correlation, prediction, reports and patch-plan
# generation. Without it Sentinel runs deterministic-only: detection, blocking,
# alerting and scanning all still work; messages are tagged
# "(analiză AI indisponibilă)".
#
# Set a spend limit on the key itself in the Anthropic console. The in-process
# budget cap in sentinel.yaml is the first line of defence, not the only one.
ANTHROPIC_API_KEY=

# --- Telegram ---------------------------------------------------------------
# From @BotFather. Create a NEW bot dedicated to Sentinel rather than reusing
# one that already carries other notifications — mixing routine alerts with
# security alerts is how security alerts stop being read.
#
# This token is the control plane. Anyone holding it can request unblocks, mute
# alerts and approve patches (subject to the chat-id allowlist and the two-step
# confirmation). Treat it like a root password; if it leaks, revoke it in
# BotFather immediately.
TELEGRAM_BOT_TOKEN=

# Your numeric chat id, from @userinfobot. Not your username.
TELEGRAM_CHAT_ID=

# --- Generated on the server ------------------------------------------------
# The installer generates these with openssl rand if they are absent. There is
# no reason for them to exist off the host, so leave them empty here.

# Signs Telegram callback tokens. Deliberately separate from the bot token: a
# leaked bot token alone must not let an attacker forge approval callbacks.
TELEGRAM_CALLBACK_HMAC_KEY=

# Signs dashboard session cookies and encrypts stored TOTP secrets, so a
# database dump alone does not yield working second factors.
SENTINEL_SESSION_SECRET=

# --- Optional ---------------------------------------------------------------
# Only if telegram.require_pin_for_apply is true. A short static PIN required
# for patch apply and allowlist changes — cheap defence in depth if a phone is
# stolen, since it is something the thief does not have.
TELEGRAM_APPLY_PIN=
