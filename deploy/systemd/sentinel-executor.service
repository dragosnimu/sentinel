[Unit]
# The only Sentinel component that runs as root.
#
# It is small (~400 lines), stdlib-only, and imports nothing from the sentinel
# package — so a compromise of the main codebase cannot reach into it. It
# validates every request against a hard-coded policy and writes the audit row
# itself, so a compromised caller can neither forge nor omit an entry.
#
# If this file ever grows a "just one more capability", stop and reconsider.
Description=Sentinel privileged action executor
Documentation=file:/opt/sentinel/libexec/README.md
After=network.target postgresql.service
PartOf=sentinel.target

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
ExecStart=/opt/sentinel/venv/bin/python /opt/sentinel/libexec/sentinel_executor.py
Restart=always
RestartSec=2

RuntimeDirectory=sentinel
RuntimeDirectoryMode=0750
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Root, but not unlimited root. Only the capabilities nftables management,
# backup/restore, and reading the audit subsystem's status genuinely need.
#
# CAP_AUDIT_CONTROL is the newest one and the one that deserves an argument,
# because it is the capability that can also SWITCH AUDITING OFF.
#
# It is here for one read-only operation, `audit_status`, which takes no
# arguments and runs `auditctl -s`. That reads the kernel's `lost` counter — how
# many audit records were thrown away because the backlog filled. The command
# history depends entirely on that counter: a dropped record looks exactly like a
# command that was never run, so without this number the history can develop
# holes and nothing says so.
#
# Measured on the host on 25 August 2026: without the capability the check
# reported `unknown` on EVERY pass, forever. Honest as a sentence, useless as a
# guard — nobody would ever have looked at the counter.
#
# Why the marginal risk is small, stated rather than assumed: this process
# already has `service_action`, which can stop auditd outright, and
# `patch_step_exec`, which runs validated commands as root. Anything able to
# abuse CAP_AUDIT_CONTROL to blind the auditing can already blind it by stopping
# the daemon. The capability widens what the process CAN do; it does not widen
# what a compromise of it could achieve.
#
# NOT in AmbientCapabilities: the bounding set is enough for a child process
# started by root, and an ambient capability is inherited by everything the
# executor spawns — including patch steps.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_SETUID CAP_SETGID CAP_KILL CAP_AUDIT_CONTROL
AmbientCapabilities=CAP_NET_ADMIN

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

# The executor runs nft, systemctl, dnf, tar and rpm. None of them needs to
# create a namespace, write a SUID file, or execute a foreign ABI — so all
# three are denied. Each is a genuine restriction rather than a score chase:
# creating a user namespace is a standard step in turning a code-execution bug
# into a privilege escalation, and this is the one component where that would
# matter.
RestrictNamespaces=yes
RestrictSUIDSGID=true
SystemCallArchitectures=native

# NoNewPrivileges and PrivateDevices are deliberately NOT set, and that costs
# real points on `systemd-analyze security`.
#
# This process runs the package manager on the operator's behalf. RPM and dpkg
# scriptlets legitimately use setuid helpers, and backup/restore touches device
# nodes. Setting either flag would score better and would break patching at the
# moment it is needed — which is a worse trade than the score suggests.
NoNewPrivileges=false
PrivateDevices=false

# Every path it may write. Adding one here is a security decision, not a
# convenience: this is the list of things root-level Sentinel can modify.
#
# -/var/lib/sentinel-executor: the "-" does NOT make a missing directory
# tolerable, and an earlier version of this comment said it did. Measured in a
# container on 5 October 2026: with the directory removed, the unit starts,
# `_prepare_audit_dir` tries to create it, and under ProtectSystem=strict the
# executor CANNOT (/var is read-only here) - it logs "cannot prepare the audit
# directory", exits 1 (status=1/FAILURE) and systemd restarts it in a loop. Without
# the "-" systemd would fail earlier, at namespace setup (226/NAMESPACE); what the
# "-" buys is the executor's own readable log line instead of a namespace error,
# nothing more. The directory is created by systemd-tmpfiles
# (deploy/tmpfiles/sentinel.conf), and production is safe only because
# deploy/install.sh applies tmpfiles BEFORE it starts this unit; anything that
# starts the unit on a host where that has not happened gets the loop.
# /var/lib/sentinel stays in this list for the audit chain's one-time migration
# read from its old, pre-fix location.
ReadWritePaths=/var/backups/sentinel /var/lib/sentinel -/var/lib/sentinel-executor /run/sentinel /etc/sentinel

RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

# The executor talks to nftables and to the local database. It has no reason to
# reach the internet, and preventing it removes an entire exfiltration path from
# the only root component.
IPAddressAllow=localhost
IPAddressDeny=any

MemoryMax=192M
TasksMax=64
OOMPolicy=stop

# A patch step's own timeout can run up to 3600s (executor/commands.py,
# op_patch_step_exec). Without this, `systemctl stop`/a reboot/an upgrade
# sends SIGTERM, the default 90s TimeoutStopSec elapses while that step is
# still legitimately running as root, and systemd SIGKILLs the process —
# which is a mid-step kill with no audit row for the operation in flight
# (sentinel_executor.py drains in-flight requests on SIGTERM specifically so
# that row gets written, but it cannot do that if it is killed first).
# KillMode=mixed sends SIGTERM to the main process only; if the drain has not
# finished by TimeoutStopSec, SIGKILL goes to every process in the unit's
# cgroup, not just the main one — the default KillMode=control-group would
# already do that, but naming it states the intent rather than relying on the
# default.
KillMode=mixed
TimeoutStopSec=3700

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-executor

[Install]
WantedBy=multi-user.target
