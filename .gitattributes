# Sentinel is authored on Windows and executed on Linux.
# A CRLF in a shell script, systemd unit or nftables file fails in confusing
# ways ("bad interpreter: /bin/bash^M"). Force LF on everything that ships to
# the server.
#
# These rules apply on commit and on checkout, so they cannot see a file that a
# tool rewrote in between — which has happened, and git hid it: the blob still
# matched HEAD, `git diff` was empty. The backstop is scripts/lib/
# check-line-endings.sh, which both deploy scripts run against the built
# package and which REFUSES it; it does not normalise anything.

* text=auto eol=lf

# Shell / config / unit files: LF, always, no exceptions.
*.sh            text eol=lf
*.bash          text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.socket        text eol=lf
*.mount         text eol=lf
*.conf          text eol=lf
*.tmpl          text eol=lf
*.nft           text eol=lf
*.rules         text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.sql           text eol=lf
*.py            text eol=lf
*.md            text eol=lf
*.json          text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.js            text eol=lf
sudoers/*       text eol=lf
logrotate/*     text eol=lf

# PowerShell is executed on Windows; CRLF is fine and expected there.
*.ps1           text eol=crlf

# Binary — never touch.
*.png           binary
*.jpg           binary
*.gz            binary
*.zst           binary
*.mmdb          binary
*.whl           binary
*.pdf           binary
